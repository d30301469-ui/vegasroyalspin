# ─── STANDALONE ADMIN (admin.vegasroyalspin.com) ─────────────────────────────────
# Upload entire admin/ folder contents to /www/wwwroot/admin.vegasroyalspin.com/
# Prefer: deploy/env/backend.env.example as the canonical production template.
# cp .env.example .env  →  fill values below

APP_ENV=production
APP_DEBUG=false
APP_KEY=CHANGE-ME-32-CHARS-MINIMUM-ADMIN-KEY!!

METROPOL_ROOT=/www/wwwroot/admin.vegasroyalspin.com
ADMIN_URL_PREFIX=

BACKEND_HOST=admin.vegasroyalspin.com
BACKEND_URL=https://admin.vegasroyalspin.com
API_PUBLIC_BASE_URL=https://admin.vegasroyalspin.com/api/v2
BACKEND_API_BASE_URL=https://admin.vegasroyalspin.com/api/v2
API_BACKEND_MAIN_BASE_URL=https://admin.vegasroyalspin.com/api/v2
API_BACKEND_FALLBACK_BASE_URL=https://admin.vegasroyalspin.com/api/v2

SITE_URL=https://vegasroyalspin.com
FRONTEND_URL=https://vegasroyalspin.com
MOBILE_URL=https://m.vegasroyalspin.com
FRONTEND_FALLBACK_URL=https://vegasroyalspin.com
PUBLIC_URL_HOSTS=vegasroyalspin.com,www.vegasroyalspin.com,m.vegasroyalspin.com
ALLOWED_URL_HOSTS=vegasroyalspin.com,www.vegasroyalspin.com,m.vegasroyalspin.com,admin.vegasroyalspin.com
DEFAULT_ALLOWED_URL_HOSTS=vegasroyalspin.com,www.vegasroyalspin.com,m.vegasroyalspin.com,admin.vegasroyalspin.com

# Must match frontend .env exactly
MEMBER_JWT_SECRET=CHANGE-ME-SAME-ON-BOTH-HOSTS-32-CHARS!!
FRONTEND_CMS_PURGE_SECRET=CHANGE-ME-SAME-ON-BOTH-HOSTS-PURGE-SECRET!!
FRONTEND_MEMBER_TRUST_SECRET=CHANGE-ME-SAME-ON-BOTH-HOSTS-TRUST-SECRET!!

LIVE_SUPPORT_URL=https://direct.lc.chat/19301899/

# MySQL — admin host ONLY (frontend must NOT have these)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=metropol_db
DB_USERNAME=metropol_user
DB_PASSWORD=CHANGE-ME

ALLOW_RUNTIME_MIGRATIONS=0
METROPOL_RUNTIME_PROVIDER_BOOTSTRAP=0

# Provider secrets (configure in admin panel or here)
BGAMING_WALLET_SECRET=
MEGAPAYZ_PRIVATE_KEY=
MEGAPAYZ_CALLBACK_TOKEN=
