# Environment example — production split-host defaults
# (vegasroyalspin119.com + admin.vegasroyalspin.com; member API admin host üzerinden /api/v2 ile servis edilir)
# Copy deploy/env/frontend.vegasroyalspin.env.example or deploy/env/backend.env.example for deploy.

APP_ENV=production
APP_DEBUG=false

SITE_URL=https://vegasroyalspin119.com
FRONTEND_URL=https://vegasroyalspin119.com
FRONTEND_FALLBACK_URL=https://vegasroyalspin119.com

BACKEND_HOST=admin.vegasroyalspin.com
BACKEND_URL=https://admin.vegasroyalspin.com
BACKEND_FALLBACK_URL=https://admin.vegasroyalspin.com

PUBLIC_URL_HOSTS=vegasroyalspin119.com,www.vegasroyalspin119.com,m.vegasroyalspin119.com
ALLOWED_URL_HOSTS=vegasroyalspin119.com,www.vegasroyalspin119.com,m.vegasroyalspin119.com,admin.vegasroyalspin.com
DEFAULT_ALLOWED_URL_HOSTS=vegasroyalspin119.com,www.vegasroyalspin119.com,m.vegasroyalspin119.com,admin.vegasroyalspin.com

SESSION_COOKIE_DOMAIN=.vegasroyalspin119.com
FRONTEND_SESSION_NAME=FRONTSESSID
ADMIN_SESSION_NAME=ADMINSESSID
ADMIN_SESSION_TIMEOUT_MINUTES=120
ADMIN_AUTH_PERSIST_COOKIE=app_admin_auth
# Prefer APP_KEY; optional dedicated HMAC for admin "remember me"
# ADMIN_AUTH_COOKIE_SECRET=
FRONTEND_MEMBER_RESTORE_COOKIE=app_member_restore

BACKEND_API_BASE_URL=https://admin.vegasroyalspin.com/api/v2
API_BACKEND_MAIN_BASE_URL=https://admin.vegasroyalspin.com/api/v2
API_BACKEND_FALLBACK_BASE_URL=https://admin.vegasroyalspin.com/api/v2
API_BACKEND_SLIDER_BASE_URL=
API_BACKEND_AFFILIATE_BASE_URL=
API_BACKEND_CASINO_WALLET_BASE_URL=
API_BACKEND_PAYMENT_CALLBACK_BASE_URL=
API_BACKEND_GAMES_BASE_URL=
API_BACKEND_AUTH_HEADER=
API_BACKEND_CURL_CAINFO=

FRONTEND_API_ONLY=1
FRONTEND_DIRECT_MEMBER_API=0
FRONTEND_MEMBER_API_CIRCUIT_SECONDS=0
FRONTEND_API_PROXY_TIMEOUT=60
FRONTEND_PUBLIC_API_CACHE_TTL=30
FRONTEND_PUBLIC_API_CACHE_STALE=300

APP_KEY=change-me-to-a-random-32-byte-secret
MEMBER_JWT_SECRET=change-me-to-a-different-random-32-byte-secret
FRONTEND_CMS_PURGE_SECRET=change-me-to-a-different-random-32-byte-purge-secret
# Üye proxy trust imzası (frontend <-> backend, her iki .env'de aynı olmalı).
# Production'da zorunlu; CMS purge secret fallback kullanılmaz.
FRONTEND_MEMBER_TRUST_SECRET=change-me-to-a-different-random-32-byte-trust-secret
# Backend'deki yıkıcı internal reset endpointleri (reset-bonus-claims,
# reset-pending-transactions) için X-Reset-Secret header değeri.
# Boşsa header ile erişim tamamen kapalıdır (yalnızca admin oturumu çalışır).
ADMIN_INTERNAL_RESET_SECRET=
CSRF_TOKEN_KEY=site_csrf_token

LIVE_SUPPORT_URL=https://direct.lc.chat/19301899/
WHATSAPP_URL=
TELEGRAM_URL=https://t.me

# Telegram Mini App / bot (BotFather). Never commit a real token.
# After creating the bot: set token + webhook secret on the server .env only.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=vegasroyalspin_bot
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_MINIAPP_URL=https://m.vegasroyalspin119.com/tg
TELEGRAM_BRAND_NAME=Vegasroyalspin

# Production requirements:
# - APP_KEY and MEMBER_JWT_SECRET must be unique, non-placeholder values with at least 32 characters.
# - Never deploy with root database users or empty database credentials on the backend host.
# - Set ALLOW_RUNTIME_MIGRATIONS=0 and APP_RUNTIME_PROVIDER_BOOTSTRAP=0 in production.
# - Member API ayrı bir api.* subdomain üzerinden DEĞİL, admin.vegasroyalspin.com/api/v2 üzerinden servis edilir.

ALLOW_RUNTIME_MIGRATIONS=0
APP_RUNTIME_PROVIDER_BOOTSTRAP=0

BGAMING_WALLET_SECRET=
MEGAPAYZ_PRIVATE_KEY=
MEGAPAYZ_SID=
MEGAPAYZ_CALLBACK_TOKEN=
MEGAPAYZ_CALLBACK_ALLOWED_IPS=
CASINO_CALLBACK_ALLOWED_IPS=
MEGAPAYZ_API_BASE_URL=https://api.megapayz.net
# Casino Aggregator: wallet auth is agent token (API spec). Set to 1 only if provider
# sends Ed25519 X-Signature and verify_public_key is configured correctly.
CASINO_AGGREGATOR_STRICT_SIGNATURE=0
CASINO_AGGREGATOR_API_BASE_URL=
BGAMING_API_BASE_URL=https://int.bgaming-system.com

# GSC+ seamless wallet — operator_code/secret_key live in gsc_config
# via Admin → GSC+ → GSC+ Ayarları (never commit secrets).
# Callback URL: https://admin.vegasroyalspin.com/api/v2/gsc-plus-wallet
# Full paths: {callback}/v1/api/seamless/{balance|withdraw|deposit|pushbetdata}
# Staging operator URL example; production URL is provided by GSC+.
GSC_OPERATOR_URL=https://staging.gsimw.com
# Staging/test integration is IDR-only — launch + seamless wallet must use IDR.
# (GSC's "Get Balance 1:1000" callback still sends currency=IDR2; we convert the
# IDR ledger ÷1000 for that case only — IDR2 is not a contracted launch currency.)
GSC_CURRENCY=IDR
# Official seamless testcase members (comma-separated). Cash is auto-kept below
# the suite's Insufficient BET (10010) so that case returns 1001.
# Only while running GSC official harness (leave empty for real play).
# GSC_TESTCASE_MEMBERS=mert1923,idtest56f3a9
# Live casino lobby lists only GSC+.
GSC_LIVE_LOBBY_ONLY=1
# Optional: python scripts/gsc_plus_v206_audit.py
#   eval "$(php scripts/gsc-export-audit-env.php --with-secret)"
#   python3 scripts/gsc_plus_v206_audit.py --full --dry-money
#   php scripts/gsc_plus_v206_static_check.php
# GSC_OPERATOR_CODE=
# GSC_SECRET_KEY=
# GSC_CALLBACK_URL=https://admin.vegasroyalspin.com/api/v2/gsc-plus-wallet
# GSC_MEMBER=Mert1923
# GSC_PRODUCT_CODE=1185

OKKO_SPORTS_API_KEY=
OKKO_SPORTS_API_SECRET=

CASINO_API_URL=
CASINO_AGENT_CODE=
CASINO_API_TOKEN=

# Backend host only — do NOT set DB_* on the frontend host (FRONTEND_API_ONLY=1)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=metropol_db
DB_USERNAME=metropol_user
DB_PASSWORD=

DATABASE_HOST=
DATABASE_PORT=
DATABASE_NAME=
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_CHARSET=

ADMIN_DB_HOST=
ADMIN_DB_PORT=
ADMIN_DB_DATABASE=
ADMIN_DB_USERNAME=
ADMIN_DB_PASSWORD=
ADMIN_DB_CHARSET=

APP_ROOT=/www/wwwroot/admin.vegasroyalspin.com
ADMIN_URL_PREFIX=

# Cloudflare edge SSL (aaPanel origin HTTP):
# CLOUDFLARE_SSL=1
# ORIGIN_HTTP=1
# API_BACKEND_INTERNAL_BASE_URL=http://127.0.0.1/api/v2
# API_BACKEND_INTERNAL_HOST=admin.vegasroyalspin.com
# php deploy/aapanel/fix-cloudflare-env.php

# Compliance / AML / Risk (optional overrides)
# COMPLIANCE_AML_WITHDRAW_THRESHOLD=25000
# COMPLIANCE_AML_DEPOSIT_THRESHOLD=25000
# COMPLIANCE_AML_RAPID_WITHDRAW_MIN=5000
# COMPLIANCE_AML_DEPOSIT_WINDOW_HOURS=24
# COMPLIANCE_AML_NEW_ACCOUNT_HOURS=72
# COMPLIANCE_AML_NEW_ACCOUNT_WITHDRAW_MIN=10000
# COMPLIANCE_AML_NEW_ACCOUNT_DEPOSIT_MIN=15000
# COMPLIANCE_AML_WITHDRAW_OVER_DEPOSIT_RATIO=1.0
# COMPLIANCE_AML_NO_DEPOSIT_WITHDRAW_MIN=1000
# COMPLIANCE_AML_KYC_WITHDRAW_MIN=15000
# COMPLIANCE_AML_STRUCTURING_HOURS=24
# COMPLIANCE_AML_STRUCTURING_COUNT=5
# COMPLIANCE_AML_STRUCTURING_MAX_EACH=10000
# COMPLIANCE_AML_STRUCTURING_MIN_TOTAL=20000
# COMPLIANCE_RISK_KYC_BALANCE_MIN=10000
# COMPLIANCE_RISK_WITHDRAW_VELOCITY_HOURS=24
# COMPLIANCE_RISK_WITHDRAW_VELOCITY_COUNT=3
# COMPLIANCE_RISK_WITHDRAW_VELOCITY_TOTAL=30000
# Risk tutma: bu tutarın ÜSTÜNDEKİ çekimler admin onaylasa bile MegaPayz/finans'a gitmez (status=risk_hold).
# RISK_WITHDRAW_HOLD_THRESHOLD=10000
# Ardışık çekim penceresi (saat) — 5000+5000 gibi parçalı toplamlar risk_hold olur.
# RISK_WITHDRAW_SERIAL_HOURS=72
# Finans onayı (risk serbest bırakma) yalnızca bu süper admin e-postası:
# RISK_WITHDRAW_RELEASE_EMAIL=zonelix@proton.me
